NEXT_PUBLIC_SITE_URL=https://webgrade.chames.tn
TRUST_PROXY=true
WEBGRADE_ANALYSIS_ENABLED=1
WEBGRADE_GUARD_DIR=/var/lib/webgrade/guard
# Application-side provider attempt caps per UTC day.
WEBGRADE_DAILY_PAGESPEED=200
WEBGRADE_DAILY_CLOUDFLARE=100
WEBGRADE_DAILY_OBSERVATORY=100
WEBGRADE_DAILY_CRUX=1000

# Leave DATABASE_URL unset for the public scanner deployment.
# Durable runs, owner login, schedules, alerts, and cloud share links stay unavailable.
# The analysis guard is stored in the named Docker volume; do not remove it during routine deploys.
PAGESPEED_API_KEY=
CRUX_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WEBGRADE_OBSERVATORY_ENABLED=1
WEBGRADE_DAILY_PAGESPEED=200
WEBGRADE_DAILY_CLOUDFLARE=100
WEBGRADE_DAILY_OBSERVATORY=100
WEBGRADE_DAILY_CRUX=1000
