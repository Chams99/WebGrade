NEXT_PUBLIC_SITE_URL=https://webgrade.chames.tn
TRUST_PROXY=true
WEBGRADE_ANALYSIS_ENABLED=1
WEBGRADE_GUARD_DIR=/var/lib/webgrade/guard
# Application-side provider attempt caps per UTC day.
WEBGRADE_DAILY_PAGESPEED=200
WEBGRADE_DAILY_CLOUDFLARE=100
WEBGRADE_DAILY_OBSERVATORY=100
WEBGRADE_DAILY_CRUX=1000
DATABASE_URL=postgres://webgrade:change-me@db:5432/webgrade
BETTER_AUTH_URL=https://webgrade.chames.tn
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBGRADE_OWNER_EMAIL=
WEBGRADE_OWNER_GITHUB_ID=
WEBGRADE_OWNER_NAME=WebGrade owner
PAGESPEED_API_KEY=
CRUX_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WEBGRADE_OBSERVATORY_ENABLED=1
WEBGRADE_DAILY_PAGESPEED=200
WEBGRADE_DAILY_CLOUDFLARE=100
WEBGRADE_DAILY_OBSERVATORY=100
WEBGRADE_DAILY_CRUX=1000
